# Django
DJANGO_SECRET_KEY=change-this-before-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_TIME_ZONE=America/Costa_Rica
DJANGO_LOG_LEVEL=INFO

# Existing SQL Server database. CoffeeTrace never creates these resources.
DB_NAME=CoffeeTrace
DB_USER=coffeetrace_app
DB_PASSWORD=replace-with-the-password-created-in-sql-server
DB_HOST=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=True
DB_TRUST_SERVER_CERTIFICATE=True
DB_CONNECTION_TIMEOUT=10
DB_QUERY_TIMEOUT=30
DB_CONNECTION_RETRIES=2
DB_RETRY_BACKOFF_SECONDS=2
DB_CONN_MAX_AGE=60

# Application
WEIGHT_TOLERANCE_KG=0.50
DEFAULT_PAGE_SIZE=20
API_ANON_RATE=100/hour
API_USER_RATE=2000/hour
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@coffeetrace.local
